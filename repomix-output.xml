import { rateLimit } from 'express-rate-limit'

const app: Application = express()

const apiRateLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  limit: 600,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    mensaje:
      'Demasiadas solicitudes. Inténtalo de nuevo más tarde.'
