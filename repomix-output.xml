              schema:
                $ref: '#/components/schemas/MensajeErrorResponse'
        '500':
          description: Error al enviar el correo
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MensajeErrorResponse'
  /api/dashboard/resumen:
    get:
      tags:
      - Dashboard
      summary: Obtener resumen, KPIs y métricas del negocio
      description: Retorna los KPIs del día (ventasHoy, ordenesHoy, clientesEstimados, mesasActivas, ocupacionPorcentaje), platos más vendidos, categorías populares y órdenes recientes. Requiere rol Administrador.
      operationId: obtenerResumenDashboard
      security:
      - bearerAuth: []
      responses:
        '200':
          description: Resumen consolidado del dashboard
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ResumenDashboardDTO'
        '401':
          description: No autenticado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MensajeErrorResponse'
        '403':
          description: Acceso denegado (requiere Administrador)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MensajeErrorResponse'
        '500':
          description: Error al generar resumen del Dashboard
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MensajeErrorResponse'
